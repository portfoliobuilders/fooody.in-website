# Hostinger / Apache helpers for the static Next.js export
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^our-story\.html$ /our-story/ [L,R=301]
  RewriteRule ^for-restaurants\.html$ /for-restaurants/ [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?fooody\.in$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Product OS lives on Railway (Option A). Brochure stays on this host.
  RewriteRule ^login(/.*)?$ https://app.fooody.in/login$1 [R=302,L]
  RewriteRule ^dashboard(/.*)?$ https://app.fooody.in/dashboard$1 [R=302,L]
  RewriteRule ^marketplace(/.*)?$ https://app.fooody.in/marketplace$1 [R=302,L]
  RewriteRule ^malabar-kitchen(/.*)?$ https://app.fooody.in/malabar-kitchen$1 [R=302,L]
  RewriteRule ^qr(/.*)?$ https://app.fooody.in/qr$1 [R=302,L]
  RewriteRule ^track(/.*)?$ https://app.fooody.in/track$1 [R=302,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

ErrorDocument 404 /404.html
