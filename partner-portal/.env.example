DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
SESSION_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost"

# Local only — ignored when NODE_ENV=production (OTP login is disabled in production)
# AUTH_DEMO_OTP="123456"

# Production (Supabase Postgres)
# NEXT_PUBLIC_APP_URL="https://app.fooody.in"
# NEXT_PUBLIC_ROOT_DOMAIN="fooody.in"
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Redis / Upstash (WhatsApp cart + session hot cache)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Image uploads
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Payments — webhooks fail closed if these secrets are unset
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# CASHFREE_WEBHOOK_SECRET=""
# STRIPE_SECRET_KEY=""

# WhatsApp Cloud API (Graph v21) — signature check fails closed if APP_SECRET is unset
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_GRAPH_VERSION="v21.0"

# 3PL dispatch
# UBER_DIRECT_CUSTOMER_ID=""
# UBER_DIRECT_TOKEN=""
# UBER_DIRECT_BASE_URL="https://api.uber.com/v1/customers"
# PORTER_API_KEY=""
# PORTER_API_URL=""
